# Compose 실행에 사용하는 예시 값.
# .env.example을 .env로 복사한 뒤 실제 값으로 바꾸고, .env는 커밋하지 않음.

# MySQL 컨테이너 초기화
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=okcare
MYSQL_USER=okcare
MYSQL_PASSWORD=change-me

# 애플리케이션이 사용하는 MySQL 접속 정보
DB_HOST=mysql
DB_PORT=3306
DB_NAME=okcare
DB_USERNAME=okcare
DB_PASSWORD=change-me

# 애플리케이션이 사용하는 Redis 접속 정보
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=CHANGE_ME
