# 개발_계획.md §10.2의 실행 절차용 예시 값이다.
# 실제 값은 cp .env.example .env 로 복사한 뒤 바꿔서 사용하고, .env는 커밋하지 않는다.

# MySQL 컨테이너 초기화
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=okcare
MYSQL_USER=okcare
MYSQL_PASSWORD=change-me

# 애플리케이션이 사용하는 MySQL 접속 정보
DB_HOST=mysql
DB_PORT=3306
DB_NAME=okcare
DB_USERNAME=okcare
DB_PASSWORD=change-me

# 애플리케이션이 사용하는 Redis 접속 정보
REDIS_HOST=redis
REDIS_PORT=6379
