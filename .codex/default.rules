# 오케어 백엔드 과제 Codex 명령 실행 규칙
#
# 기준은 AGENTS.md의 「항상 적용하는 원칙」과 「변경과 커밋 통제」다.
# Claude Code의 동등한 통제는 .claude/settings.json에 있다. 한쪽을 바꾸면 다른 쪽도 함께 본다.
#
# allow  = 저장소 상태를 바꾸지 않는 조회와 검증
# prompt = 저장소·외부 상태를 바꾸거나 되돌리기 어려운 명령

# 로컬 조회와 진단
prefix_rule(pattern=["codex", "doctor"], decision="allow")
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "config"], decision="allow")
prefix_rule(pattern=["git", "ls-files"], decision="allow")
prefix_rule(pattern=["git", "worktree", "list"], decision="allow")

# 빌드와 테스트. 개발_계획.md §11의 검증 순서에 사용한다.
# 단일 모듈 프로젝트이므로 모듈 접두사가 붙은 태스크는 두지 않는다.
prefix_rule(pattern=["./gradlew", "--version"], decision="allow")
prefix_rule(pattern=["./gradlew", "compileJava"], decision="allow")
prefix_rule(pattern=["./gradlew", "compileTestJava"], decision="allow")
prefix_rule(pattern=["./gradlew", "test"], decision="allow")
prefix_rule(pattern=["./gradlew", "build"], decision="allow")
prefix_rule(pattern=["./gradlew", "clean", "build"], decision="allow")

# 컨테이너 읽기 전용 조회. .claude/settings.json의 allow 목록과 같은 범위다.
prefix_rule(pattern=["docker", "compose", "ps"], decision="allow")
prefix_rule(pattern=["docker", "compose", "logs"], decision="allow")
prefix_rule(pattern=["docker", "compose", "config"], decision="allow")
prefix_rule(pattern=["docker", "ps"], decision="allow")
prefix_rule(pattern=["docker", "inspect"], decision="allow")
prefix_rule(pattern=["docker", "logs"], decision="allow")

# GitHub 읽기 전용 조회
prefix_rule(pattern=["gh", "auth", "status"], decision="allow")
prefix_rule(pattern=["gh", "issue", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "list"], decision="allow")

# Orca 상태와 결과 조회. 운영 규칙은 docs/운영/오케스트레이션_가이드.md를 따른다.
prefix_rule(pattern=["orca", "status"], decision="allow")
prefix_rule(pattern=["orca", "skills", "get"], decision="allow")
prefix_rule(pattern=["orca", "repo", "show"], decision="allow")
prefix_rule(pattern=["orca", "worktree", "current"], decision="allow")
prefix_rule(pattern=["orca", "worktree", "ps"], decision="allow")
prefix_rule(pattern=["orca", "worktree", "show"], decision="allow")
prefix_rule(pattern=["orca", "worktree", "list"], decision="allow")
prefix_rule(pattern=["orca", "terminal", "list"], decision="allow")
prefix_rule(pattern=["orca", "terminal", "show"], decision="allow")
prefix_rule(pattern=["orca", "terminal", "read"], decision="allow")
prefix_rule(pattern=["orca", "terminal", "wait"], decision="allow")
prefix_rule(pattern=["orca", "orchestration", "task-list"], decision="allow")
prefix_rule(pattern=["orca", "orchestration", "dispatch-show"], decision="allow")
prefix_rule(pattern=["orca", "orchestration", "check"], decision="allow")
prefix_rule(pattern=["orca", "orchestration", "inbox"], decision="allow")

# Orca 작업자 탭 운영. 오케스트레이션_가이드.md §4의 오케스트레이터 책임 범위다.
prefix_rule(pattern=["orca", "terminal", "create"], decision="allow")
prefix_rule(pattern=["orca", "terminal", "rename"], decision="allow")
prefix_rule(pattern=["orca", "terminal", "send"], decision="allow")
prefix_rule(pattern=["orca", "terminal", "close"], decision="allow")
prefix_rule(pattern=["orca", "orchestration", "task-create"], decision="allow")
prefix_rule(pattern=["orca", "orchestration", "dispatch"], decision="allow")
prefix_rule(pattern=["orca", "orchestration", "send"], decision="allow")
prefix_rule(pattern=["orca", "worktree", "set"], decision="allow")

# Git 저장소 상태 변경과 원격 쓰기.
# AGENTS.md: 사용자가 명시적으로 요청하기 전에는 스테이징하거나 커밋하지 않는다.
prefix_rule(pattern=["git", "add"], decision="prompt")
prefix_rule(pattern=["git", "commit"], decision="prompt")
prefix_rule(pattern=["git", "push"], decision="prompt")
prefix_rule(pattern=["git", "reset"], decision="prompt")
prefix_rule(pattern=["git", "restore"], decision="prompt")
prefix_rule(pattern=["git", "checkout"], decision="prompt")
prefix_rule(pattern=["git", "switch"], decision="prompt")
prefix_rule(pattern=["git", "branch"], decision="prompt")
prefix_rule(pattern=["git", "merge"], decision="prompt")
prefix_rule(pattern=["git", "rebase"], decision="prompt")
prefix_rule(pattern=["git", "cherry-pick"], decision="prompt")
prefix_rule(pattern=["git", "clean"], decision="prompt")
prefix_rule(pattern=["git", "fetch"], decision="prompt")
prefix_rule(pattern=["git", "pull"], decision="prompt")
prefix_rule(pattern=["git", "worktree", "add"], decision="prompt")
prefix_rule(pattern=["git", "worktree", "remove"], decision="prompt")
prefix_rule(pattern=["git", "worktree", "prune"], decision="prompt")

# Orca worktree lifecycle 변경은 승인 범위 밖이다.
prefix_rule(pattern=["orca", "worktree", "create"], decision="prompt")
prefix_rule(pattern=["orca", "worktree", "stop"], decision="prompt")
prefix_rule(pattern=["orca", "worktree", "rm"], decision="prompt")

# GitHub 외부 상태 변경과 범용 HTTP 호출
prefix_rule(pattern=["gh", "issue", "create"], decision="prompt")
prefix_rule(pattern=["gh", "issue", "edit"], decision="prompt")
prefix_rule(pattern=["gh", "pr", "create"], decision="prompt")
prefix_rule(pattern=["gh", "pr", "edit"], decision="prompt")
prefix_rule(pattern=["gh", "pr", "merge"], decision="prompt")
prefix_rule(pattern=["gh", "api"], decision="prompt")
prefix_rule(pattern=["curl"], decision="prompt")

# 컨테이너 상태 변경. 개발_계획.md §10.2의 Compose 기동과 종료가 여기 해당한다.
# docker compose down --volumes는 MySQL 데이터를 삭제하므로 반드시 확인을 거친다.
prefix_rule(pattern=["docker", "compose"], decision="prompt")
prefix_rule(pattern=["docker", "build"], decision="prompt")
prefix_rule(pattern=["docker", "run"], decision="prompt")
prefix_rule(pattern=["docker", "exec"], decision="prompt")
prefix_rule(pattern=["docker", "start"], decision="prompt")
prefix_rule(pattern=["docker", "stop"], decision="prompt")
prefix_rule(pattern=["docker", "rm"], decision="prompt")
prefix_rule(pattern=["docker", "volume"], decision="prompt")

# 애플리케이션 기동과 데이터 저장소 직접 접속
prefix_rule(pattern=["./gradlew", "bootRun"], decision="prompt")
prefix_rule(pattern=["mysql"], decision="prompt")
prefix_rule(pattern=["mysqladmin"], decision="prompt")
prefix_rule(pattern=["redis-cli"], decision="prompt")

# 임의 셸 실행
prefix_rule(pattern=["/bin/zsh"], decision="prompt")
prefix_rule(pattern=["/bin/bash"], decision="prompt")
prefix_rule(pattern=["sh", "-c"], decision="prompt")

# 파일 이동과 삭제
prefix_rule(pattern=["cp"], decision="prompt")
prefix_rule(pattern=["mv"], decision="prompt")
prefix_rule(pattern=["rm"], decision="prompt")
