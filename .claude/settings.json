{
  "includeCoAuthoredBy": false,
  "permissions": {
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/docs-lint.py",
            "timeout": 30,
            "statusMessage": "문서 링크와 줄 끝 공백 검사"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/secret-scan.py",
            "timeout": 30,
            "statusMessage": "staged 변경 자격 증명 검사"
          }
        ]
      }
    ]
  }
}
